#---------------------------------------------------------------------------------
# Moonlighter for GameCube: an Octave C++ project around the code of the
# Moonlighter-Recomp repository (a checkout next to this one).
#
# Normally built by Octave's packager:
#   Octave.exe -headless -project <path>/MLGC.octp -build GameCube
# which runs this makefile, then writes Packaged/GameCube/ (.dol + .iso).
#
# By hand: make -f Makefile_GCN  -> Build/GCN/MLGC.dol
# Links the prebuilt Octave engine (octave-libogc Engine/Makefile_GCN).
#---------------------------------------------------------------------------------
.SUFFIXES:
.SECONDARY:

ifeq ($(strip $(DEVKITPPC)),)
$(error "Please set DEVKITPPC in your environment. export DEVKITPPC=<path to>devkitPPC")
endif

include $(DEVKITPPC)/gamecube_rules

export OCTAVE ?= $(abspath $(CURDIR)/../../octave-libogc)
export ML_REPO ?= $(abspath $(CURDIR)/../../moonlighter)
export ML_SRC := $(ML_REPO)/recomp/src
# Box2D 2.3.1 (Unity's 2D physics' engine; unity/PhysicsWorld), vendored in Moonlighter-Recomp.
export ML_BOX2D := $(ML_REPO)/recomp/third_party/box2d
# libtess2: how Unity cuts a PolygonCollider2D into convex pieces (recomp/src/unity/PolygonCollider2D)
export ML_TESS2 := $(ML_REPO)/recomp/third_party/libtess2

TARGET		:=	MLGC
BUILD		:=	Intermediate/GCN
SOURCES		:=	Source Generated \
				$(ML_SRC)/cs $(ML_SRC)/unity $(ML_SRC)/util $(ML_SRC)/game $(ML_SRC)/render \
				$(addprefix $(ML_BOX2D)/Box2D/,Collision Collision/Shapes Common Dynamics Dynamics/Contacts Dynamics/Joints) \
				$(ML_TESS2)/Source
OUTPUT_DIR	:=	$(CURDIR)/Build/GCN

# -ffp-contract=off: no fused multiply-adds, so the float arithmetic rounds
# like the game's (the generator's draws depend on it: Random.Range(float)).
CFLAGS	= -g -O2 -Wall -ffp-contract=off $(MACHDEP) $(INCLUDE) -DPLATFORM_GAMECUBE=1 -DPLATFORM_DOLPHIN=1 -DAPI_GX=1
CXXFLAGS	=	$(CFLAGS) -std=gnu++20

# AUTOTOUR=N (test builds): every N frames the next room, then the next floor and dungeon,
# the free memory logged per floor (Source/MoonGame.cpp).
ifneq ($(AUTOTOUR),)
CFLAGS	+=	-DMLGC_AUTOTOUR=$(AUTOTOUR)
endif
# AUTOWALK=1 (test builds): Will walks a fixed stick script; his position, state and room go to
# Dolphin's log.
ifneq ($(AUTOWALK),)
CFLAGS	+=	-DMLGC_AUTOWALK
endif
# PADLOG=1 (test builds): what the pad reads, in Dolphin's log every second.
ifneq ($(PADLOG),)
CFLAGS	+=	-DMLGC_PADLOG
endif
# ENEMYROOM=1 (test builds): the floor starts in its first room with live enemies.
ifneq ($(ENEMYROOM),)
CFLAGS	+=	-DMLGC_ENEMYROOM
endif
# BREAKTEST=1 (test builds): Will beside a room's first breakable, swinging.
ifneq ($(BREAKTEST),)
CFLAGS	+=	-DMLGC_BREAKTEST
endif
# ENDROOM=1 (test builds): the floor starts in its room with the next-level door, Will walking at it.
ifneq ($(ENDROOM),)
CFLAGS	+=	-DMLGC_ENDROOM
endif
# GECKOLOG=1: the log, live over a USB Gecko (DolphinWorks' Debug console).
ifneq ($(GECKOLOG),)
CFLAGS	+=	-DOCT_GECKO_LOG=1
endif

# TRANSLATED=1: the game's own code translated into C++ (Moonlighter-Recomp's tools/translate,
# docs/translator_plan.md), compiled in with the scene facade (recomp/src/bind) it runs on. The
# translator runs here first, as recomp/translated.cmake runs it: against your copy of the game
# (ML_GAME, the folder with Moonlighter_Data; the builder sets it), into Intermediate/gen (never
# committed). It runs again when units.txt, bindings.tsv or the tool's sources change. Needs the
# .NET 9 SDK (dotnet). The game itself still runs the hand port (recomp/src/game): what isn't
# called is left out by --gc-sections.
# TTEST=1 (test builds, implies TRANSLATED=1): no game; the disc runs the BabySlime's oracle
# replay (data/oracle/slime.jsonl) against the translated code and then against the hand port,
# timed with the Gekko's timebase, its rows and numbers in Dolphin's log (Source/TranslatedTest.cpp;
# tools/make_test_data.py puts the replay's data on the disc, tools/dolphin_test.ps1 runs it).
# TTEST_PROFILE=1 (with TTEST): the translated replay alone, sampled (where its time goes:
# tools/ttest_profile.py reads the samples with MLGC.elf's symbols).
ifneq ($(TTEST),)
export TRANSLATED := 1
CFLAGS	+=	-DMLGC_TTEST=1
endif
ifneq ($(TTEST_PROFILE),)
CFLAGS	+=	-DMLGC_TTEST_PROFILE=1
endif
# TTEST_GC_AUTO=1 (with TTEST): the translated replay collects when enough was made (as the game
# does), not at every frame end. TTEST_SQRT=1: Moonlighter-Recomp's GekkoSqrt against newlib's on
# every float in [1, 4) first.
ifneq ($(TTEST_GC_AUTO),)
CFLAGS	+=	-DMLGC_TTEST_GC_AUTO=1
endif
ifneq ($(TTEST_SQRT),)
CFLAGS	+=	-DMLGC_TTEST_SQRT=1
endif
ifneq ($(TRANSLATED),)
CFLAGS	+=	-DMLGC_TRANSLATED=1
endif

# --gc-sections: what nothing uses stays out.
LDFLAGS	=	-g $(MACHDEP) -Wl,-Map,$(notdir $@).map -Wl,--gc-sections -Wl,--no-eh-frame-hdr

# No -lbba: Source/octave_unused.cpp stands in for Octave's network code.
LIBS	:=	-lEngine -lBullet -lasnd -lfat -logc -lm

# The engine without what this never uses (Octave's Engine/OctFeatures.mk).
export OCT_PHYSICS := 0
export OCT_NAVIGATION := 0
export OCT_VORBIS := 0
export OCT_NETWORK := 0
export OCT_VIDEO := 0
export OCT_SPLINES := 0
export OCT_SKELETAL := 0
export OCT_PARTICLES := 0
export OCT_INSTANCING := 0
export OCT_TEXT3D := 0
export OCT_UI_EXTRAS := 0
export OCT_CONSOLE := 0
export OCT_STATS := 0
export OCT_LUA := 0
include $(OCTAVE)/Engine/OctFeatures.mk
CFLAGS	+=	$(OCT_DEFINES)

ENGINE_LIB_DIR := $(OCTAVE)/Engine/Build/GCN$(OCT_VARIANT)
BULLET_LIB_DIR := $(OCTAVE)/External/Bullet/Build/GCN

ifneq ($(notdir $(BUILD)),$(notdir $(CURDIR)))
#---------------------------------------------------------------------------------

export VPATH	:=	$(foreach dir,$(SOURCES),$(abspath $(dir)))
export DEPSDIR	:=	$(CURDIR)/$(BUILD)

CFILES		:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.c)))
CPPFILES	:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.cpp)))

export LD	:=	$(CXX)
export OFILES	:=	$(CPPFILES:.cpp=.o) $(CFILES:.c=.o)
# TRANSLATED: where the translator writes (the project's Intermediate/, which git ignores).
ifneq ($(TRANSLATED),)
export ML_GEN	:=	$(CURDIR)/Intermediate/gen
endif

# The port's headers first: its game/ and render/ before Octave's own folders.
export INCLUDE	:=	-I$(ML_SRC) \
					$(if $(TRANSLATED),-I$(ML_GEN)) \
					-I$(ML_BOX2D) \
					-I$(ML_TESS2)/Include \
					-I$(CURDIR)/Source \
					-I$(OCTAVE)/Engine/Source \
					-I$(OCTAVE)/Engine/Source/Engine \
					-I$(OCTAVE)/External \
					-I$(OCTAVE)/External/Bullet \
					-I$(CURDIR)/$(BUILD) \
					-I$(LIBOGC_INC)

export LIBPATHS	:=	-L$(ENGINE_LIB_DIR) -L$(BULLET_LIB_DIR) -L$(LIBOGC_LIB)

export ENGINE_LIB := $(ENGINE_LIB_DIR)/libEngine.a
export OUTPUT	:=	$(OUTPUT_DIR)/$(TARGET)

.PHONY: $(BUILD) OutputDir EngineLib Translate clean

$(BUILD): OutputDir EngineLib $(if $(TRANSLATED),Translate)
	@[ -d $@ ] || mkdir -p $@
	@$(MAKE) --no-print-directory -C $(BUILD) -f $(CURDIR)/Makefile_GCN

OutputDir:
	@[ -d $(OUTPUT_DIR) ] || mkdir -p $(OUTPUT_DIR)

# The engine library built as above (up to date: nothing to do).
EngineLib:
	@$(MAKE) --no-print-directory -C $(OCTAVE)/Engine -f Makefile_GCN

# TRANSLATED: the translator, when its inputs changed since it last ran (recomp/translated.cmake's
# command; the decompiled game is cached in Moonlighter-Recomp's recomp/gen/decompiled).
ML_TRANSLATE := $(ML_REPO)/tools/translate
ML_TRANSLATE_INPUTS := $(ML_TRANSLATE)/units.txt $(ML_TRANSLATE)/bindings.tsv $(ML_TRANSLATE)/Translate.csproj \
					$(wildcard $(ML_TRANSLATE)/*.cs)
Translate: $(ML_GEN)/translated.stamp
$(ML_GEN)/translated.stamp: $(ML_TRANSLATE_INPUTS)
	@echo translating the game code with tools/translate ...
	@dotnet run --project "$(ML_TRANSLATE)" -c Release -- translate --out "$(ML_GEN)" $(if $(ML_GAME),--managed "$(ML_GAME)/Moonlighter_Data/Managed")
	@touch $@

clean:
	@echo clean ...
	@rm -fr $(BUILD) $(OUTPUT).dol $(OUTPUT).elf

#---------------------------------------------------------------------------------
else

# TRANSLATED: the translated sources (the list the translator wrote, sources.cmake) and the scene
# facade, their objects named gen_<file>.o and bind_<file>.o: this folder holds every object by
# its file's name, and the translation's names (Enemy, Constants, Chest...) are the hand port's too.
ifneq ($(TRANSLATED),)
GEN_SOURCES	:=	$(shell sed -n 's|.*/\([^/]*\.cpp\).*|\1|p' "$(ML_GEN)/sources.cmake")
BIND_SOURCES	:=	$(notdir $(wildcard $(ML_SRC)/bind/*.cpp))
OFILES	+=	$(addprefix gen_,$(GEN_SOURCES:.cpp=.o)) $(addprefix bind_,$(BIND_SOURCES:.cpp=.o))
# Generated code: the untranslated methods' stubs leave parameters, locals and labels unused; C#'s
# switches leave enum values out; cs_trace takes its fields' offsets (offsetof on classes with
# virtual functions). Smaller code, the same results (Moonlighter-Recomp's tools/gcsize measures it):
# the translated code runs on one thread, so its function-local statics (the string literals) need
# no guard; and no IPA-SRA clones, which are local to each file (a copy of the same template
# function in every file that calls it).
GEN_CXXFLAGS	:=	-Wno-unused-parameter -Wno-unused-variable -Wno-unused-but-set-variable -Wno-unused-label -Wno-switch \
				-Wno-invalid-offsetof -fno-threadsafe-statics -fno-ipa-sra

gen_%.o: $(ML_GEN)/%.cpp
	$(SILENTMSG) $(notdir $<)
	$(SILENTCMD)$(CXX) -MMD -MP -MF $(DEPSDIR)/gen_$*.d $(CPPFLAGS) $(CXXFLAGS) $(GEN_CXXFLAGS) -c $< -o $@ $(ERROR_FILTER)

bind_%.o: $(ML_SRC)/bind/%.cpp
	$(SILENTMSG) $(notdir $<)
	$(SILENTCMD)$(CXX) -MMD -MP -MF $(DEPSDIR)/bind_$*.d $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@ $(ERROR_FILTER)
endif

# TTEST: the replays themselves (Moonlighter-Recomp's tests), their main()s renamed for
# Source/TranslatedTest.cpp to call. The translated one is built as its ctest is: tests/translated
# first on the include path (its game/*.h name the translated classes).
ifneq ($(TTEST),)
VPATH	+=	$(ML_REPO)/recomp/tests $(ML_REPO)/recomp/tests/translated $(ML_REPO)/recomp/tests/translated/scene
OFILES	+=	slime_test.o enemy_translated_test.o Standins.o
slime_test.o: CXXFLAGS += -DML_TEST_MAIN=SlimeTestMain
enemy_translated_test.o: CXXFLAGS += -DML_TEST_MAIN=EnemyTranslatedTestMain
enemy_translated_test.o Standins.o: INCLUDE := -I$(ML_REPO)/recomp/tests/translated $(INCLUDE)
TranslatedTest.o: INCLUDE := $(INCLUDE) -I$(ML_REPO)/recomp/tests
endif

# The build's variant: when TRANSLATED, TTEST or TTEST_PROFILE changes, what reads them is compiled
# again, which links the program again. (With .SECONDARY, make skips a missing object whose source is
# older than the program: a variant's own objects would be missed.)
VARIANT_FILE	:=	$(DEPSDIR)/variant.txt
VARIANT	:=	TRANSLATED=$(TRANSLATED) TTEST=$(TTEST) TTEST_PROFILE=$(TTEST_PROFILE) TTEST_GC_AUTO=$(TTEST_GC_AUTO) TTEST_SQRT=$(TTEST_SQRT)
$(shell [ "$$(cat $(VARIANT_FILE) 2>/dev/null)" = "$(VARIANT)" ] || echo "$(VARIANT)" > $(VARIANT_FILE))

$(OUTPUT).dol: $(OUTPUT).elf
$(OUTPUT).elf: $(OFILES) $(ENGINE_LIB)
Main.o TranslatedTest.o TranslatedLoad.o: $(VARIANT_FILE)

-include $(DEPSDIR)/*.d

#---------------------------------------------------------------------------------
endif
#---------------------------------------------------------------------------------
