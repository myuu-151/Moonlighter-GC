#---------------------------------------------------------------------------------
# Moonlighter for GameCube: an Octave C++ project around the code of the
# Moonlighter-Recomp repository (a checkout next to this one).
#
# Normally built by Octave's packager:
#   Octave.exe -headless -project <path>/MLGC.octp -build GameCube
# which runs this makefile, then writes Packaged/GameCube/ (.dol + .iso).
#
# By hand: make -f Makefile_GCN  -> Build/GCN/MLGC.dol
# Links the prebuilt Octave engine (octave-libogc Engine/Makefile_GCN).
#---------------------------------------------------------------------------------
.SUFFIXES:
.SECONDARY:

ifeq ($(strip $(DEVKITPPC)),)
$(error "Please set DEVKITPPC in your environment. export DEVKITPPC=<path to>devkitPPC")
endif

include $(DEVKITPPC)/gamecube_rules

export OCTAVE ?= $(abspath $(CURDIR)/../../octave-libogc)
export ML_REPO ?= $(abspath $(CURDIR)/../../moonlighter)
export ML_SRC := $(ML_REPO)/recomp/src
# Box2D 2.3.1 (Unity's 2D physics' engine; unity/PhysicsWorld), vendored in Moonlighter-Recomp.
export ML_BOX2D := $(ML_REPO)/recomp/third_party/box2d
# libtess2: how Unity cuts a PolygonCollider2D into convex pieces (recomp/src/unity/PolygonCollider2D)
export ML_TESS2 := $(ML_REPO)/recomp/third_party/libtess2

TARGET		:=	MLGC
BUILD		:=	Intermediate/GCN
SOURCES		:=	Source Generated \
				$(ML_SRC)/cs $(ML_SRC)/unity $(ML_SRC)/util $(ML_SRC)/game $(ML_SRC)/render \
				$(addprefix $(ML_BOX2D)/Box2D/,Collision Collision/Shapes Common Dynamics Dynamics/Contacts Dynamics/Joints) \
				$(ML_TESS2)/Source
OUTPUT_DIR	:=	$(CURDIR)/Build/GCN

# -ffp-contract=off: no fused multiply-adds, so the float arithmetic rounds
# like the game's (the generator's draws depend on it: Random.Range(float)).
CFLAGS	= -g -O2 -Wall -ffp-contract=off $(MACHDEP) $(INCLUDE) -DPLATFORM_GAMECUBE=1 -DPLATFORM_DOLPHIN=1 -DAPI_GX=1
CXXFLAGS	=	$(CFLAGS) -std=gnu++20

# AUTOTOUR=N (test builds): every N frames the next room, then the next floor and dungeon,
# the free memory logged per floor (Source/MoonGame.cpp).
ifneq ($(AUTOTOUR),)
CFLAGS	+=	-DMLGC_AUTOTOUR=$(AUTOTOUR)
endif
# AUTOWALK=1 (test builds): Will walks a fixed stick script; his position, state and room go to
# Dolphin's log.
ifneq ($(AUTOWALK),)
CFLAGS	+=	-DMLGC_AUTOWALK
endif
# PADLOG=1 (test builds): what the pad reads, in Dolphin's log every second.
ifneq ($(PADLOG),)
CFLAGS	+=	-DMLGC_PADLOG
endif
# ENEMYROOM=1 (test builds): the floor starts in its first room with live enemies.
ifneq ($(ENEMYROOM),)
CFLAGS	+=	-DMLGC_ENEMYROOM
endif
# BREAKTEST=1 (test builds): Will beside a room's first breakable, swinging.
ifneq ($(BREAKTEST),)
CFLAGS	+=	-DMLGC_BREAKTEST
endif
# ENDROOM=1 (test builds): the floor starts in its room with the next-level door, Will walking at it.
ifneq ($(ENDROOM),)
CFLAGS	+=	-DMLGC_ENDROOM
endif
# GECKOLOG=1: the log, live over a USB Gecko (DolphinWorks' Debug console).
ifneq ($(GECKOLOG),)
CFLAGS	+=	-DOCT_GECKO_LOG=1
endif

# --gc-sections: what nothing uses stays out.
LDFLAGS	=	-g $(MACHDEP) -Wl,-Map,$(notdir $@).map -Wl,--gc-sections -Wl,--no-eh-frame-hdr

# No -lbba: Source/octave_unused.cpp stands in for Octave's network code.
LIBS	:=	-lEngine -lBullet -lasnd -lfat -logc -lm

# The engine without what this never uses (Octave's Engine/OctFeatures.mk).
export OCT_PHYSICS := 0
export OCT_NAVIGATION := 0
export OCT_VORBIS := 0
export OCT_NETWORK := 0
export OCT_VIDEO := 0
export OCT_SPLINES := 0
export OCT_SKELETAL := 0
export OCT_PARTICLES := 0
export OCT_INSTANCING := 0
export OCT_TEXT3D := 0
export OCT_UI_EXTRAS := 0
export OCT_CONSOLE := 0
export OCT_STATS := 0
export OCT_LUA := 0
include $(OCTAVE)/Engine/OctFeatures.mk
CFLAGS	+=	$(OCT_DEFINES)

ENGINE_LIB_DIR := $(OCTAVE)/Engine/Build/GCN$(OCT_VARIANT)
BULLET_LIB_DIR := $(OCTAVE)/External/Bullet/Build/GCN

ifneq ($(notdir $(BUILD)),$(notdir $(CURDIR)))
#---------------------------------------------------------------------------------

export VPATH	:=	$(foreach dir,$(SOURCES),$(abspath $(dir)))
export DEPSDIR	:=	$(CURDIR)/$(BUILD)

CFILES		:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.c)))
CPPFILES	:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.cpp)))

export LD	:=	$(CXX)
export OFILES	:=	$(CPPFILES:.cpp=.o) $(CFILES:.c=.o)

# The port's headers first: its game/ and render/ before Octave's own folders.
export INCLUDE	:=	-I$(ML_SRC) \
					-I$(ML_BOX2D) \
					-I$(ML_TESS2)/Include \
					-I$(CURDIR)/Source \
					-I$(OCTAVE)/Engine/Source \
					-I$(OCTAVE)/Engine/Source/Engine \
					-I$(OCTAVE)/External \
					-I$(OCTAVE)/External/Bullet \
					-I$(CURDIR)/$(BUILD) \
					-I$(LIBOGC_INC)

export LIBPATHS	:=	-L$(ENGINE_LIB_DIR) -L$(BULLET_LIB_DIR) -L$(LIBOGC_LIB)

export ENGINE_LIB := $(ENGINE_LIB_DIR)/libEngine.a
export OUTPUT	:=	$(OUTPUT_DIR)/$(TARGET)

.PHONY: $(BUILD) OutputDir EngineLib clean

$(BUILD): OutputDir EngineLib
	@[ -d $@ ] || mkdir -p $@
	@$(MAKE) --no-print-directory -C $(BUILD) -f $(CURDIR)/Makefile_GCN

OutputDir:
	@[ -d $(OUTPUT_DIR) ] || mkdir -p $(OUTPUT_DIR)

# The engine library built as above (up to date: nothing to do).
EngineLib:
	@$(MAKE) --no-print-directory -C $(OCTAVE)/Engine -f Makefile_GCN

clean:
	@echo clean ...
	@rm -fr $(BUILD) $(OUTPUT).dol $(OUTPUT).elf

#---------------------------------------------------------------------------------
else

$(OUTPUT).dol: $(OUTPUT).elf
$(OUTPUT).elf: $(OFILES) $(ENGINE_LIB)

-include $(DEPSDIR)/*.d

#---------------------------------------------------------------------------------
endif
#---------------------------------------------------------------------------------
